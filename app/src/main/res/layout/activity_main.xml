<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090D16">

    <!-- Static Image Wallpaper Layer -->
    <ImageView
        android:id="@+id/wallpaperImageView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <!-- Live Video Wallpaper Layer -->
    <VideoView
        android:id="@+id/wallpaperVideoView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Sleek Dark Gradient Readability Scrim -->
    <View
        android:id="@+id/scrimOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99070B14" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="44dp"
            android:paddingTop="32dp"
            android:paddingBottom="36dp">

            <!-- Top Glass Header Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/brandTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.08"
                        android:text="RADION"
                        android:textColor="#38BDF8"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/greetingText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Good Evening"
                        android:textColor="#F8FAFC"
                        android:textSize="28sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Quick Action Pills -->
                <Button
                    android:id="@+id/wallpaperButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="10dp"
                    android:text="Wallpaper"
                    android:textAllCaps="false"
                    android:textColor="#F1F5F9"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/wifiButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="10dp"
                    android:text="Wi-Fi"
                    android:textAllCaps="false"
                    android:textColor="#F1F5F9"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/settingsButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="28dp"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="10dp"
                    android:text="Settings"
                    android:textAllCaps="false"
                    android:textColor="#F1F5F9"
                    android:textSize="15sp" />

                <!-- Right Clock & Date -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/clockText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="08:40 PM"
                        android:textColor="#FFFFFF"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/dateText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Friday, Nov 20"
                        android:textColor="#94A3B8"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Favorites Row (Shown when user pins apps) -->
            <LinearLayout
                android:id="@+id/favoritesSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="Pinned Favorites"
                    android:textColor="#E2E8F0"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:focusable="false"
                    android:paddingVertical="8dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/favoritesRowContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clipChildren="false"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>

            <!-- All Installed Apps Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="All Apps"
                    android:textColor="#E2E8F0"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hold OK on any app to Pin / Unpin"
                    android:textColor="#64748B"
                    android:textSize="13sp" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:focusable="false"
                android:paddingVertical="10dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/appsRowContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

        </LinearLayout>
    </ScrollView>
</FrameLayout>
